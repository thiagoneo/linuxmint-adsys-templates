<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Linux Mint policy</displayName>
  <description>This is the Linux Mint / Cinnamon policy</description>
  <resources>

    <stringTable>
      <!-- Cinnamon category names -->
      <string id="LinuxMintDisplayRoot">Linux Mint</string>
      <string id="CinnamonDisplayRoot">Cinnamon</string>
      <string id="CinnamonDisplayDesktop">Desktop</string>
      <string id="CinnamonDisplayBackground">Background</string>
      <string id="CinnamonDisplayPanel">Panel</string>
      <string id="CinnamonDisplaySession">Session</string>
      <string id="CinnamonDisplayMedia">Media</string>
      <string id="CinnamonDisplayPower">Power</string>
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonDesktopBackgroundPictureUri">Picture URI</string>
      <string id="CinnamonDisplayUser2404DconfOrgCinnamonDesktopBackgroundPictureUri">Picture URI</string>
      <string id="CinnamonDisplayUser2204DconfOrgCinnamonDesktopBackgroundPictureUri">Picture URI</string>
      <string id="CinnamonDisplayUser2004DconfOrgCinnamonDesktopBackgroundPictureUri">Picture URI</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonDesktopBackgroundPictureUri">URI to use for the background image. Note that the backend only supports local (file://) URIs.

- Type: dconf
- Key: /org/cinnamon/desktop/background/picture-uri
- Default: &#39;file:///usr/share/backgrounds/linuxmint/default_background.jpg&#39;

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions">Picture Options</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions0">none</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions1">wallpaper</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions2">centered</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions3">scaled</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions4">stretched</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions5">zoom</string>
      <string id="CinnamonItemUserAllDconfOrgCinnamonDesktopBackgroundPictureOptions6">spanned</string>
      <string id="CinnamonDisplayUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions">Picture Options</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions0">none</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions1">wallpaper</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions2">centered</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions3">scaled</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions4">stretched</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions5">zoom</string>
      <string id="CinnamonItemUser2404DconfOrgCinnamonDesktopBackgroundPictureOptions6">spanned</string>
      <string id="CinnamonDisplayUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions">Picture Options</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions0">none</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions1">wallpaper</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions2">centered</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions3">scaled</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions4">stretched</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions5">zoom</string>
      <string id="CinnamonItemUser2204DconfOrgCinnamonDesktopBackgroundPictureOptions6">spanned</string>
      <string id="CinnamonDisplayUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions">Picture Options</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions0">none</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions1">wallpaper</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions2">centered</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions3">scaled</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions4">stretched</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions5">zoom</string>
      <string id="CinnamonItemUser2004DconfOrgCinnamonDesktopBackgroundPictureOptions6">spanned</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonDesktopBackgroundPictureOptions">Determines how the image set by wallpaper_filename is rendered. Possible values are “none”, “wallpaper”, “centered”, “scaled”, “stretched”, “zoom”, “spanned”.

- Type: dconf
- Key: /org/cinnamon/desktop/background/picture-options
- Default: &#39;zoom&#39;

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonCinnamonSessionQuitDelayToggle">Enable timer when logging out or shutting down</string>
      <string id="CinnamonDisplayUser2404DconfOrgCinnamonCinnamonSessionQuitDelayToggle">Enable timer when logging out or shutting down</string>
      <string id="CinnamonDisplayUser2204DconfOrgCinnamonCinnamonSessionQuitDelayToggle">Enable timer when logging out or shutting down</string>
      <string id="CinnamonDisplayUser2004DconfOrgCinnamonCinnamonSessionQuitDelayToggle">Enable timer when logging out or shutting down</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonCinnamonSessionQuitDelayToggle">Enable timer when logging out or shutting down

- Type: dconf
- Key: /org/cinnamon/cinnamon-session/quit-delay-toggle
- Default: true

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonCinnamonSessionQuitTimeDelay">Time delay when logging out or shutting down (seconds)</string>
      <string id="CinnamonDisplayUser2404DconfOrgCinnamonCinnamonSessionQuitTimeDelay">Time delay when logging out or shutting down (seconds)</string>
      <string id="CinnamonDisplayUser2204DconfOrgCinnamonCinnamonSessionQuitTimeDelay">Time delay when logging out or shutting down (seconds)</string>
      <string id="CinnamonDisplayUser2004DconfOrgCinnamonCinnamonSessionQuitTimeDelay">Time delay when logging out or shutting down (seconds)</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonCinnamonSessionQuitTimeDelay">Time delay when logging out or shutting down (seconds).

- Type: dconf
- Key: /org/cinnamon/cinnamon-session/quit-time-delay
- Default: 60

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <!-- Panel icon sizes -->
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonPanelZoneIconSizes">Panel Icon Sizes</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonPanelZoneIconSizes">Size of the icons displayed on the Cinnamon panel zones.
The value must be a JSON string, for example: [{"panelId": 1, "left": 0, "center": 0, "right": 16}]
Use 0 to inherit the panel height for a zone.

- Type: dconf
- Key: /org/cinnamon/panel-zone-icon-sizes
- Default: '[{"panelId": 1, "left": 0, "center": 0, "right": 16}]'

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <!-- Enabled applets -->
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonEnabledApplets">Enabled applets</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonEnabledApplets">Default enabled applets on the Cinnamon panel.
Enter one applet per line, without brackets or quotes, in the format:
panelName:zone:position:appletId:instanceId

Example:
panel1:left:0:menu@cinnamon.org:0
panel1:right:0:user@cinnamon.org:3

- Type: dconf (as)
- Key: /org/cinnamon/enabled-applets

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <!-- Auto-open on mount -->
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonDesktopMediaHandlingAutomountOpen">Auto-open File Manager on Mount</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonDesktopMediaHandlingAutomountOpen">Whether to automatically open a file manager window when a removable storage device is mounted.

- Type: dconf
- Key: /org/cinnamon/desktop/media-handling/automount-open
- Default: false

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <!-- Display idle timeout (AC) -->
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonSettingsDaemonPluginsPowerSleepDisplayAc">Display Idle Timeout (AC)</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonSettingsDaemonPluginsPowerSleepDisplayAc">Number of seconds of inactivity before the display is turned off when on AC power.
Set to 0 to never turn off the display automatically.

- Type: dconf
- Key: /org/cinnamon/settings-daemon/plugins/power/sleep-display-ac
- Default: 2700

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>
      <!-- Suspend timeout (AC) -->
      <string id="CinnamonDisplayUserAllDconfOrgCinnamonSettingsDaemonPluginsPowerSleepInactiveAcTimeout">Suspend Timeout (AC)</string>
      <string id="CinnamonExplainTextUserDconfOrgCinnamonSettingsDaemonPluginsPowerSleepInactiveAcTimeout">Number of seconds of inactivity before the system suspends when on AC power.
Set to 0 to disable automatic suspend.

- Type: dconf
- Key: /org/cinnamon/settings-daemon/plugins/power/sleep-inactive-ac-timeout
- Default: 0

Note: default system value is used for &#34;Not Configured&#34; and enforced if &#34;Disabled&#34;.

Supported on Linux Mint 20.x, 21.x, 22.x</string>

    </stringTable>

