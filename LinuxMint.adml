      <presentation id="CinnamonPresentationUserDconfOrgCinnamonDesktopBackgroundPictureUri">
        <textBox refId="CinnamonElemUserAllDconfOrgCinnamonDesktopBackgroundPictureUri">
          <label>Picture URI</label>
          <defaultValue>'file:///usr/share/backgrounds/linuxmint/default_background.jpg'</defaultValue>
        </textBox>
        <text/>
        <checkBox refId="CinnamonOverrideElemUser2404DconfOrgCinnamonDesktopBackgroundPictureUri" defaultChecked="false">Override value for 22.x:</checkBox>
        <textBox refId="CinnamonElemUser2404DconfOrgCinnamonDesktopBackgroundPictureUri">
          <label></label>
          <defaultValue>'file:///usr/share/backgrounds/linuxmint/default_background.jpg'</defaultValue>
        </textBox>
        <text/>
        <checkBox refId="CinnamonOverrideElemUser2204DconfOrgCinnamonDesktopBackgroundPictureUri" defaultChecked="false">Override value for 21.x:</checkBox>
